# stats.fl: a module that imports another module.
#
# the import at the top is why this file can call shapes.area() without
# defining it. the import binds the module's exports under one name, and every
# call goes through that name. there is no bare `area` in scope here: the two
# modules keep their own names, so a helper in one can never overwrite a
# helper of the same name in the other.

import "shapes.fl" as shapes

# total_area() is this module's interface. everything else here is an
# implementation detail.
export fn total_area(items) {
    let total = 0
    let i = 0
    while i < len(items) {
        total += shapes.area(items[i])
        i += 1
    }
    return total
}

export fn largest(items) {
    let best = nil
    let best_area = 0
    let i = 0
    while i < len(items) {
        let a = shapes.area(items[i])
        # `a > best_area` rather than `if a`. zero is truthy in flint, so
        # testing the number directly would take the branch on the first
        # iteration whatever the areas were. see docs/values.md
        if a > best_area {
            best_area = a
            best = items[i]
        }
        i += 1
    }
    return best
}
