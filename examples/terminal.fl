# terminal.fl -- the widgets, one per line, no cursor moves.
#
# run it:  ./flint examples/terminal.fl
#
# these return strings and draw nothing, so the output is the same in a
# terminal and in a log file and nothing here needs a tty. a real progress
# bar redraws one line with a cursor-up escape, and that loop belongs to the
# caller: terminal is the widget, not the animation.

import terminal

print("width x height: " + str(terminal.width()) + " x " + str(terminal.height()))
print(terminal.progress_bar(0.0, 24))
print(terminal.progress_bar(0.25, 24))
print(terminal.progress_bar(0.75, 24))
print(terminal.progress_bar(1.0, 24))

# the fraction is clamped, so a ratio computed wrong still draws
print(terminal.progress_bar(1.4, 24))

# a spinner is this call inside a sleep loop. one frame at a time is all a
# script can honestly show, since frame 2 with no frame 1 is a lie.
let frames = []
let i = 0
while i < 4 {
    push(frames, terminal.spinner_frame(i))
    i += 1
}
print(frames)

# the url travels in an OSC-8 escape; a terminal that does not know it prints
# just the text. no tty is required, and neither is a supporting terminal.
print(terminal.hyperlink("flint", "https://example.com/flint"))
print("is_tty: " + str(terminal.is_tty()))
