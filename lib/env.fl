# env -- environment variables, read and written by name.
#
#     import env
#     print(env.string("HOME", ""))
#     if env.bool("DEBUG", false) {
#         print("debugging")
#     }
#
# the runtime already has env(name), os.getenv(name, fallback),
# os.setenv and os.unsetenv. this module is the layer on top of those: it
# parses the values. a variable is text on the way in, and what the script
# wants -- a number, a yes-or-no, a list of paths -- on the way out. every
# getter takes the value to use when the variable is not set, so a caller
# never has to branch on nil.

# the variable as text, or fallback when it is not set. note that an empty
# value is a value: set-but-empty returns "", not fallback.
export fn string(name, fallback) {
    return __os_getenv(name, fallback)
}

# whether the variable is set at all. this asks the question the string()
# form cannot answer on its own, because a variable set to "" is present
# and env.string cannot tell that from a fallback of "".
export fn has(name) {
    return __os_lookupenv(name) != nil
}

# set it for this process and its children. returns false when the name is
# invalid -- empty, or containing "=". the value itself is not checked,
# because setenv does not need it to be. one platform exception: on
# windows an empty value is refused (false), because the system call
# would delete the variable instead of setting it.
export fn set(name, value) {
    return __os_setenv(name, value)
}

# remove it. unsetting a variable that was never set succeeds: a script
# asking for a variable to be absent has got what it wanted.
export fn unset(name) {
    return __os_unsetenv(name)
}

# the variable as a number, or fallback when it is unset or is not text
# that names a number. both are quietly the fallback rather than an error,
# because the usual reason to read PORT or WORKERS is that someone running
# the script may have got it wrong, and the caller should be able to say so
# without a try around every read.
export fn int(name, fallback) {
    let text = __os_lookupenv(name)
    if text == nil {
        return fallback
    }
    return num(text)
}

# the variable as true or false. what counts as true: "1", "true", "yes",
# "on" and "y", in any case, with surrounding space ignored. everything else
# that is set -- including "0", "false" and "no" -- is false, and a variable
# that is not set is fallback. a config file that spells it wrongly should
# not turn into a crash.
export fn bool(name, fallback) {
    let text = __os_lookupenv(name)
    if text == nil {
        return fallback
    }
    let word = lower(trim(text))
    if word == "1" or word == "true" or word == "yes" or word == "on" or word == "y" {
        return true
    }
    return false
}

# the variable split on the platform's path separator, as PATH and friends
# are written: "PATH=/usr/bin:/bin" -> ["/usr/bin", "/bin"]. unset gives an
# empty list, never nil, so a caller can loop over the result without
# checking first. empty entries are dropped, which is what a trailing or
# doubled separator means and what every other tool on the platform does
# with it.
export fn paths(name) {
    let text = __os_lookupenv(name)
    if text == nil or text == "" {
        return []
    }
    let parts = split(text, __os_pathlistsep())
    let out = []
    let i = 0
    while i < len(parts) {
        if parts[i] != "" {
            push(out, parts[i])
        }
        i += 1
    }
    return out
}

# expand a leading ~ to the user's home directory. a tilde anywhere else, or
# a ~ with no home directory to expand to, is left alone: the caller gave
# us a path and the useful thing to do with an unexpandable one is hand it
# back and let the next call report the real problem.
export fn expand(path) {
    if __slice(path, 0, 1) != "~" {
        return path
    }
    let home = __os_homedir()
    if home == nil {
        return path
    }
    let rest = __slice(path, 1, len(path))
    if rest == "" {
        return home
    }
    return home + rest
}
