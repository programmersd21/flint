# pretty_print -- a value rendered across lines, for debugging.
#
#     import pretty_print
#     pretty_print.pretty_print([1, [2, 3]])
#
# `pretty_print(v)` prints, `pretty_output(v)` returns the string. nested
# lists and tables indent by two spaces per level. this is a debugging aid,
# not a serializer: strings print bare, and there is no parsing the output
# back.

const DEFAULT_INDENT = 2

fn pretty_lines(v) {
    let lines = []

    if type(v) == "table" {
        let names = keys(v)
        if len(names) == 0 {
            push(lines, "{}")
            return lines
        }
        let step = ""
        for i in 0..DEFAULT_INDENT { step = step + " " }
        push(lines, "{")
        for name in names {
            let sub = pretty_lines(v[name])
            let last = len(sub) - 1
            for j in 0..len(sub) {
                let line = step
                if j == 0 {
                    line = line + name + ": "
                } else {
                    line = line + "  "
                }
                line = line + sub[j]
                if j == last { line = line + "," }
                push(lines, line)
            }
        }
        push(lines, "}")
        return lines
    }

    if type(v) != "list" {
        push(lines, str(v))
        return lines
    }
    if len(v) == 0 {
        push(lines, "[]")
        return lines
    }

    let step = ""
    for i in 0..DEFAULT_INDENT { step = step + " " }

    push(lines, "[")
    for item in v {
        let sub = pretty_lines(item)
        let last = len(sub) - 1
        for j in 0..len(sub) {
            let line = step + sub[j]
            if j == last { line = line + "," }
            push(lines, line)
        }
    }
    push(lines, "]")
    return lines
}


export fn pretty_output(v) {
    let lines = pretty_lines(v)
    let out = lines[0]
    for j in 1..len(lines) {
        out = out + "\n" + lines[j]
    }
    return out
}

export fn pretty_print(v) {
    print(pretty_output(v))
}
