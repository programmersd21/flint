# glob -- shell-style filename matching, with no dependencies.
#
#     import glob
#     print(glob.match("*.fl", "args.fl"))
#     print(glob.filter("*.fl", ["a.fl", "b.txt"]))
#     print(glob.list("lib", "*.fl"))
#
# patterns support `*` (any run, including empty), `?` (exactly one
# character) and `[...]` classes with ranges (`[a-z]`) and negation
# (`[!abc]`). anything else matches literally. matching is by hand over
# characters with __slice/ord/len, so this module imports nothing.
#
# list() returns its results sorted, because the filesystem does not promise
# an order and a test that depends on readdir order is a test that fails on
# someone else's machine. the sort is a small insertion sort on strings.

# match(pattern, name) says whether the whole name fits the pattern. an
# empty pattern matches only the empty name; a trailing `*` matches
# everything after it, including nothing.
export fn match(pattern, name) {
    return _match(pattern, 0, name, 0)
}

# _match walks pattern[pi:] against name[si:]. `*` greedily consumes and
# backtracks one character at a time; `?` takes exactly one character; a
# class takes exactly one character from its set. recursion depth follows
# the pattern length, which is short in practice.
export fn _match(pattern, pi, name, si) {
    let plen = len(pattern)
    let slen = len(name)
    while pi < plen {
        let pc = __slice(pattern, pi, pi + 1)
        if pc == "*" {
            # collapse runs of stars: one star already means any run.
            while pi + 1 < plen and __slice(pattern, pi + 1, pi + 2) == "*" {
                pi += 1
            }
            if pi + 1 >= plen {
                return true
            }
            let k = si
            while k <= slen {
                if _match(pattern, pi + 1, name, k) {
                    return true
                }
                k += 1
            }
            return false
        }
        if si >= slen {
            return false
        }
        if pc == "?" {
            pi += 1
            si += 1
        } else if pc == "[" {
            let end = _class_end(pattern, pi)
            if end == -1 {
                # no closing bracket: the `[` is literal.
                if __slice(name, si, si + 1) != "[" {
                    return false
                }
                pi += 1
                si += 1
            } else {
                if not _class_hit(__slice(pattern, pi, end + 1), __slice(name, si, si + 1)) {
                    return false
                }
                pi = end + 1
                si += 1
            }
        } else {
            if pc != __slice(name, si, si + 1) {
                return false
            }
            pi += 1
            si += 1
        }
    }
    return si >= slen
}

# _class_end finds the index of the `]` closing the class opened at pi, or
# -1 when there is none. a `]` first (after an optional `!`/`^`) closes
# nothing: it is a literal member, as in `[]a]`.
export fn _class_end(pattern, pi) {
    let i = pi + 1
    if i < len(pattern) and (__slice(pattern, i, i + 1) == "!" or __slice(pattern, i, i + 1) == "^") {
        i += 1
    }
    if i < len(pattern) and __slice(pattern, i, i + 1) == "]" {
        i += 1
    }
    while i < len(pattern) {
        if __slice(pattern, i, i + 1) == "]" {
            return i
        }
        i += 1
    }
    return -1
}

# _class_hit says whether one character is in the class text, which includes
# its brackets. ranges (`a-z`) match inclusively; a trailing or leading `-`
# is literal. `!`/`^` first negates the set.
export fn _class_hit(cls, ch) {
    let start = 1
    let neg = false
    if __slice(cls, 1, 2) == "!" or __slice(cls, 1, 2) == "^" {
        neg = true
        start = 2
    }
    # skip a literal leading `]`, which _class_end already accounted for.
    if start < len(cls) - 1 and __slice(cls, start, start + 1) == "]" {
        if ch == "]" {
            return not neg
        }
        start += 1
    }
    let hit = false
    let i = start
    while i < len(cls) - 1 {
        let lo = __slice(cls, i, i + 1)
        if lo == "-" {
            if ch == "-" {
                hit = true
            }
            i += 1
        } else if i + 2 < len(cls) and __slice(cls, i + 1, i + 2) == "-" and __slice(cls, i + 2, i + 3) != "]" {
            let hi = __slice(cls, i + 2, i + 3)
            if ord(lo) <= ord(ch) and ord(ch) <= ord(hi) {
                hit = true
            }
            i += 3
        } else {
            if ch == lo {
                hit = true
            }
            i += 1
        }
    }
    if neg {
        return not hit
    }
    return hit
}

# filter(pattern, names) keeps the names that match. the input order is
# kept: filtering selects, it does not sort.
export fn filter(pattern, names) {
    let out = []
    let i = 0
    while i < len(names) {
        if match(pattern, names[i]) {
            push(out, names[i])
        }
        i += 1
    }
    return out
}

# _sort orders strings in place (insertion sort) and returns the list. the
# lists here are directory entries, tens of items, where a simple sort is
# the readable choice and fast enough.
export fn _sort(xs) {
    let i = 1
    while i < len(xs) {
        let key = xs[i]
        let j = i - 1
        while j >= 0 and __strcmp(xs[j], key) > 0 {
            xs[j + 1] = xs[j]
            j -= 1
        }
        xs[j + 1] = key
        i += 1
    }
    return xs
}

# list(dir, pattern) matches match() against each entry of dir, skipping
# "." and "..", and returns the hits sorted. nil when the directory cannot
# be read; an empty list when nothing matches.
export fn list(dir, pattern) {
    let entries = __listdir(dir)
    if entries == nil {
        return nil
    }
    let out = []
    let i = 0
    while i < len(entries) {
        let e = entries[i]
        if e != "." and e != ".." and match(pattern, e) {
            push(out, e)
        }
        i += 1
    }
    return _sort(out)
}
