# collections -- the list helpers everyone writes twice.
#
#     import collections
#     print(collections.sum([1, 2, 3]))
#
# everything here works on a list and returns a new one where that makes
# sense. nothing mutates its argument unless its name says it does. that rule
# is why `sort` is not here yet: sorting has to mutate or copy, and picking
# one silently is how a library loses somebody's data.

# the total. an empty list is 0, which is what an empty total is.
export fn sum(xs) {
    let total = 0
    let i = 0
    while i < len(xs) {
        total += xs[i]
        i += 1
    }
    return total
}

# the largest, or nil for an empty list. nil rather than an error, because
# "the list was empty" is a normal thing to ask about and a caller that does
# not care can ignore the answer.
export fn max(xs) {
    if len(xs) == 0 { return nil }
    let best = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] > best { best = xs[i] }
        i += 1
    }
    return best
}

export fn min(xs) {
    if len(xs) == 0 { return nil }
    let best = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] < best { best = xs[i] }
        i += 1
    }
    return best
}

export fn avg(xs) {
    if len(xs) == 0 { return nil }
    return sum(xs) / len(xs)
}

# a copy, in the other order
export fn reverse(xs) {
    let out = []
    let i = len(xs) - 1
    while i >= 0 {
        push(out, xs[i])
        i -= 1
    }
    return out
}

# the first element equal to v, or nil. a list helper, not a generic search.
export fn index_of(xs, v) {
    let i = 0
    while i < len(xs) {
        if xs[i] == v { return i }
        i += 1
    }
    return nil
}

export fn contains(xs, v) {
    return index_of(xs, v) != nil
}

# a copy with the duplicates dropped, order kept. this is what a script
# usually means by "unique" and what a set would give in another order.
export fn unique(xs) {
    let out = []
    let i = 0
    while i < len(xs) {
        if not contains(out, xs[i]) {
            push(out, xs[i])
        }
        i += 1
    }
    return out
}

# the first n, or all of them
export fn take(xs, n) {
    let out = []
    let i = 0
    while i < len(xs) and i < n {
        push(out, xs[i])
        i += 1
    }
    return out
}

# everything after the first n
export fn drop(xs, n) {
    let out = []
    let i = n
    while i < len(xs) {
        push(out, xs[i])
        i += 1
    }
    return out
}

export fn sort(xs) {
    if len(xs) <= 1 { return xs }

    let out = []
    let ci = 0
    while ci < len(xs) {
        push(out, xs[ci])
        ci += 1
    }

    let kind = type(out[0])
    if kind != "number" and kind != "string" {
        throw TypeError("collections.sort needs numbers or strings, got " + str(kind))
    }

    let n = len(out)
    let i = 0
    while i < n {
        let j = 0
        while j < n - i - 1 {
            if type(out[j]) != kind or type(out[j+1]) != kind {
                throw TypeError("collections.sort needs only one kind of element")
            }
            # out of order?
            let swap = false
            if kind == "number" {
                if out[j] > out[j+1] { swap = true }
            } else {
                if __strcmp(out[j], out[j+1]) > 0 { swap = true }
            }
            if swap {
                let tmp = out[j]
                out[j] = out[j+1]
                out[j+1] = tmp
            }
            j += 1
        }
        i += 1
    }
    return out
}








# map(xs, f) -- a new list of f applied to each element, in order.
#
#     print(collections.map([1, 2, 3], fn(x) { return x * 2 }))    # [2, 4, 6]
#
# f is called with one argument and its result is kept, so a callback that
# returns nil drops a nil into the list rather than shrinking it. an error
# raised inside f propagates: map does not swallow it.
export fn map(xs, f) {
    let out = []
    let i = 0
    while i < len(xs) {
        push(out, f(xs[i]))
        i += 1
    }
    return out
}

# filter(xs, f) -- the elements f accepted, in order.
#
#     print(collections.filter([1, 5, 9, 2], fn(x) { return x > 3 }))  # [5, 9]
#
# f returns something truthy to keep an element. zero counts: only nil and
# false are falsy, which is the same rule as everywhere else in flint.
export fn filter(xs, f) {
    let out = []
    let i = 0
    while i < len(xs) {
        if f(xs[i]) {
            push(out, xs[i])
        }
        i += 1
    }
    return out
}

# reduce(xs, f) -- fold the list into one value, left to right.
#
#     print(collections.reduce([1, 2, 3, 4], fn(a, b) { return a + b }))  # 10
#
# an empty list has nothing to fold, so it returns nil. a one-element list
# returns that element without calling f at all, which means reduce over
# one item is not a way to check that f works.
export fn reduce(xs, f) {
    if len(xs) == 0 {
        return nil
    }
    let acc = xs[0]
    let i = 1
    while i < len(xs) {
        acc = f(acc, xs[i])
        i += 1
    }
    return acc
}

# reverse(xs) -- the elements back to front.
#
# collections.reverse() is not this: that one mutates in place, because
# "reverse" on a list usually means "reverse it". this one copies, because
# a helper that both mutates and copies is a helper nobody trusts.
export fn reversed(xs) {
    let out = []
    let i = len(xs) - 1
    while i >= 0 {
        push(out, xs[i])
        i -= 1
    }
    return out
}

# enumerate(xs) -- each element paired with its index.
#
#     let xs = ["a", "b"]
#     for pair in collections.enumerate(xs) { print(pair[0], pair[1]) }
#
# a list of two-element lists. note that the two-variable `for` form is for
# tables, so a list of pairs is read by index rather than unpacked:
#
#     for i, x in xs { ... }        # xs is a table
#
# an empty list yields an empty result.
export fn enumerate(xs) {
    let out = []
    let i = 0
    while i < len(xs) {
        push(out, [i, xs[i]])
        i += 1
    }
    return out
}

# zip(a, b) -- elements of two lists, paired, stopping at the shorter one.
#
#     let out = collections.zip([1, 2], ["a", "b"])   # [[1, "a"], [2, "b"]]
#
# stopping short rather than padding or erroring: zip is a convenience, and a
# length mismatch is the caller's data to check, not a failure inside the
# helper. an empty list on either side gives an empty result.
export fn zip(a, b) {
    let out = []
    let n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let i = 0
    while i < n {
        push(out, [a[i], b[i]])
        i += 1
    }
    return out
}

# range_list(start, end, step) -- the numbers start..end..step as a list.
#
# this is a convenience over the step form of a for loop, for when you want
# the numbers rather than a loop. the same rules apply: a zero step is an
# error, and the range is half-open.
export fn range_list(start, end, step) {
    if step == 0 {
        throw ValueError("collections.range_list step cannot be zero")
    }
    let out = []
    let i = start
    if step > 0 {
        while i < end {
            push(out, i)
            i += step
        }
    } else {
        while i > end {
            push(out, i)
            i += step
        }
    }
    return out
}
