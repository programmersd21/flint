# a tight numeric loop, no allocation, no calls. this is flint's weakest case
# and it is here because of that, not in spite of it: every value is a
# nan-boxed double, so each add is a double add, and python's small ints are
# tagged and not boxed at all. the gap here is structural.
let acc = 0
let i = 0
while i < 20000000 {
    acc += i * 2
    acc += 1
    i += 1
}
print(acc)
