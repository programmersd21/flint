# collections — the list helpers. every result here is deterministic.

import collections

# sum
print(collections.sum([1, 2, 3]))      # 6
print(collections.sum([]))             # 0
print(collections.sum([10]))           # 10

# min / max
print(collections.min([3, 1, 4, 1, 5]))   # 1
print(collections.max([3, 1, 4, 1, 5]))   # 5
print(collections.min([]))                # nil
print(collections.max([]))                # nil

# avg
print(collections.avg([2, 4, 6]))      # 4
print(collections.avg([]))             # nil

# reverse
print(collections.reverse([1, 2, 3]))  # [3, 2, 1]
print(collections.reverse([]))         # []

# contains / index_of
print(collections.contains([1, 2, 3], 2))   # true
print(collections.contains([1, 2, 3], 9))   # false
print(collections.index_of([10, 20, 30], 20))  # 1
print(collections.index_of([10, 20, 30], 99))  # nil

# unique
print(collections.unique([1, 2, 1, 3, 2]))  # [1, 2, 3]

# take / drop
print(collections.take([1, 2, 3, 4], 2))    # [1, 2]
print(collections.drop([1, 2, 3, 4], 2))    # [3, 4]
print(collections.take([1, 2], 10))         # [1, 2]
print(collections.drop([1, 2], 10))         # []
