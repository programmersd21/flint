import env
import os

# set/has/unset round trip
env.set("FLINT_ENV_TEST", "hello")
print(env.has("FLINT_ENV_TEST"))
print(env.string("FLINT_ENV_TEST", "missing"))
env.unset("FLINT_ENV_TEST")
print(env.has("FLINT_ENV_TEST"))
print(env.string("FLINT_ENV_TEST", "missing"))

# set to the empty string is still set -- except on windows, where an
# empty value deletes the variable instead (the C runtime refuses the
# set and returns false, so has() would disagree with set() otherwise).
# both branches print true, asserting each platform's own contract, so
# the one expected file holds on every system.
if os.name() == "windows" {
    print(env.set("FLINT_ENV_EMPTY", "") == false)
} else {
    env.set("FLINT_ENV_EMPTY", "")
    print(env.has("FLINT_ENV_EMPTY"))
    env.unset("FLINT_ENV_EMPTY")
}

# unset of a name that was never set succeeds
env.unset("FLINT_ENV_NEVER_SET")
print("unset missing ok")

# numbers
env.set("FLINT_ENV_PORT", "8080")
print(env.int("FLINT_ENV_PORT", 1))
env.set("FLINT_ENV_BADNUM", "eight")
try {
    print(env.int("FLINT_ENV_BADNUM", 1))
} catch e {
    print("bad number raised")
}
env.unset("FLINT_ENV_PORT")
env.unset("FLINT_ENV_BADNUM")
print(env.int("FLINT_ENV_PORT", 1))

# booleans, in every spelling that means yes
env.set("FLINT_ENV_B1", "1")
env.set("FLINT_ENV_B2", "TRUE")
env.set("FLINT_ENV_B3", "Yes")
env.set("FLINT_ENV_B4", " on ")
env.set("FLINT_ENV_B5", "y")
env.set("FLINT_ENV_B6", "0")
env.set("FLINT_ENV_B7", "false")
env.set("FLINT_ENV_B8", "maybe")
print(env.bool("FLINT_ENV_B1", false))
print(env.bool("FLINT_ENV_B2", false))
print(env.bool("FLINT_ENV_B3", false))
print(env.bool("FLINT_ENV_B4", false))
print(env.bool("FLINT_ENV_B5", false))
print(env.bool("FLINT_ENV_B6", true))
print(env.bool("FLINT_ENV_B7", true))
print(env.bool("FLINT_ENV_B8", true))
print(env.bool("FLINT_ENV_UNSET", true))
let i = 1
while i <= 8 {
    env.unset("FLINT_ENV_B" + str(i))
    i += 1
}

# path lists
let sep = __os_pathlistsep()
env.set("FLINT_ENV_PATH", "/usr/bin" + sep + sep + "/bin" + sep)
print(env.paths("FLINT_ENV_PATH"))
print(env.paths("FLINT_ENV_UNSET"))
env.unset("FLINT_ENV_PATH")

# tilde expansion. only the leading one, and only when there is a home.
print(env.expand("/tmp/plain"))
print(env.expand("~") == __os_homedir())
print(env.expand("~/x") == __os_homedir() + "/x")
print(env.expand("a~b"))
