# A module that exports a const, imported twice.
#
# The second import is a cache hit and does not re-run the module, so the
# const is defined once. That was also true in v0.5.0, where re-running was
# harmless because re-declaring a const with the same value is idempotent; now
# it is a lookup rather than a second run, which is stronger and is what makes
# a module's private state actually private.
import "const_source.fl" as c
import "const_source.fl" as c

print(c.LIMIT)
print(c.doubled())

# and the module is still reachable through its namespace afterwards
print(c.LIMIT)
