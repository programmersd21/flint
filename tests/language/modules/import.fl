# modules.
#
# import paths are resolved against the process working directory, not against
# the importing file, so these are repo-root-relative. That is a known
# limitation; see import_declaration() in src/frontend/compiler.c.

# the basic case: a name from another file is just a global afterwards
import "helper.fl"
print(square(6))

# an exported constant and an exported variable
print(LIMIT)
print(counter)

# a function from the module calling another function from the same module.
# this is the one that used to segfault: the module's OP_RETURN unwound the
# frame of the script that was still running, so the dispatch loop kept
# going and ran the rest of this file a second time.
print(hypotenuse_sq(3, 4))

# two modules in one script, with work after each import
import "geometry.fl"
print(describe())
print(square(9))

# import inside a function. the import reenters the interpreter with a frame
# already on the stack, which is the case run() has to unwind correctly.
fn load_and_use() {
	import "helper.fl"
	return square(5)
}
print(load_and_use())

# and the module's functions still work afterwards
print(square(7))

# local variables before and after an import must survive it
let before = 1
print(before)
import "helper.fl"
let after = 2
print(after)
print(before + after)
